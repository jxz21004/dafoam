FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
geometry
{
    type basic;
}

fluxScheme JST;
jst_k2 0.5;
jst_k4 0.02;
sensorName pressure;
lowMachAusm          false;

ddtSchemes
{
    default          bounded dualTime rPseudoDeltaT steadyState;
}

gradSchemes
{
    default Gauss linear;
    gradTVD          Gauss linear;
    grad(nuTilda) Gauss linear;
}

divSchemes
{
    default          none;

    div(tauMC)       Gauss linear;
    div(phi,nuTilda) bounded Gauss upwind;

    // DAFoam adjoint preconditioner
    div(pc)          bounded Gauss upwind;
}

laplacianSchemes
{
    default                     Gauss linear hisaLimited 0.5;
    laplacian(muEff,U)          Gauss linear hisaLimited 0.33;
    laplacian(alphaEff,e)       Gauss linear hisaLimited 0.33;
}

interpolationSchemes
{
    default          linear;
    reconstruct(rho) firstOrder;
    reconstruct(U) firstOrder;
    reconstruct(T) firstOrder;
}

snGradSchemes
{
    default          hisaLimited 0.5;
}

wallDist
{
    method meshWave;
}
// ************************************************************************* //
