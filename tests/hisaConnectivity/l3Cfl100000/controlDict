FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime 10000;
deltaT          1;
writeControl    timeStep;
writeInterval 2000;
purgeWrite      0;
writeFormat     ascii;
writePrecision 17;
writeCompression on;
timeFormat      general;
timePrecision   10;
runTimeModifiable true;

DebugSwitches
{
    SolverPerformance 0;
}


HisaPrintInterval 1;
